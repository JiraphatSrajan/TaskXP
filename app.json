{
  "expo": {
    "name": "TaskXP",
    "slug": "taskxp-ready",
    "version": "1.0.0",
    "scheme": "taskxp",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F7FD"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.taskxp.ready",
      "buildNumber": "1.0.0"
    },
    "android": {
      "package": "com.taskxp.ready",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F7FD"
      }
    },
    "plugins": [
      "expo-notifications",
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePickerStyle": "spinner",
            "timePickerStyle": "spinner"
          }
        }
      ]
    ]
  }
}
